{
  "manifest_version": 3,
  "name": "HxxTranslate",
  "version": "1.1.0",
  "description": "面向中文用户的轻量级网页翻译扩展，由 HxxBot 提供账户与翻译能力。支持英文朗读。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "HxxTranslate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "identity", "tabs", "tts"],
  "host_permissions": [
    "https://www.hxxbot.com/*",
    "https://hxxbot.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ]
}
